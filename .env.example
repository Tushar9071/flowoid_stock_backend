# Environment Variables configuration
# Copy this file to .env and replace the values with your actual configuration

# Database
# Provide your PostgreSQL database connection string
DATABASE_URL="postgresql://user:password@host:port/database_name"

# Server Configuration
PORT="3000"
NODE_ENV="development"

# CORS
# Development allows all origins. Production only allows the comma-separated origins listed here.
CORS_ORIGINS="https://flowoid.tech"

# Authentication (JWT)
# Generate secure random strings for your secrets (e.g., using `openssl rand -hex 32`)
JWT_SECRET="your_jwt_secret"
JWT_EXPIRES_IN="7d"

JWT_ACCESS_SECRET="your_jwt_access_secret_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_here"

# Token expiration times
JWT_ACCESS_EXPIRES_IN="30m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cookie Configuration
AUTH_COOKIE_SAME_SITE="lax"

# Public base URL used to expose generated document URLs when needed
APP_BASE_URL="http://localhost:3000"

# WhatsApp Cloud API
WHATSAPP_WEBHOOK_VERIFY_TOKEN="flowoid_whatsapp_verify_2025"
WHATSAPP_API_VERSION="v19.0"
ENCRYPTION_SECRET="replace_with_32_char_random_secret"
# NEVER run prisma db push on production.
# Always use: pnpm db:migrate
LOG_LEVEL=info
LOG_TO_DB=true
LOG_DB_QUERIES=false
BACKUP_DIR=/var/backups/flowoid
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *
DB_LOGS_MAX_ROWS=100000
