# Copy this file to .env.docker for local docker compose usage.

PORT=8000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
DATABASE_URL=postgresql://user:password@your-postgres-host:5432/flowoid

JWT_SECRET=replace_with_long_random_secret
JWT_ACCESS_SECRET=replace_with_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false

APP_BASE_URL=http://localhost:8000
PUBLIC_API_URL=http://localhost:8000

WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace_with_verify_token
WHATSAPP_API_VERSION=v19.0
ENCRYPTION_SECRET=replace_with_32_char_random_secret

LOG_LEVEL=info
LOG_TO_DB=true
LOG_DB_QUERIES=false
BACKUP_DIR=/var/backups/flowoid
DOCUMENT_STORAGE_DIR=/app/storage/generated-documents
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *
DB_LOGS_MAX_ROWS=100000
